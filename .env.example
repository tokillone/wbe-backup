# 使用 SPRING_PROFILES_ACTIVE=prod 启用生产配置。
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=

# 数据库与后端同机容器化时，DB_URL 中主机名可使用 Docker 私有网络服务名。
# 远程数据库请在 DB_URL 中使用 sslMode=VERIFY_IDENTITY 等 MySQL TLS 参数。
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_POOL_MAX_SIZE=
DB_POOL_MIN_IDLE=
DB_CONNECTION_TIMEOUT_MS=
DB_VALIDATION_TIMEOUT_MS=
DB_IDLE_TIMEOUT_MS=
DB_MAX_LIFETIME_MS=
DB_KEEPALIVE_TIME_MS=

# 认证会话、验证码与限流依赖 Redis；生产环境必须提供可用连接。
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=
REDIS_CONNECT_TIMEOUT=
REDIS_TIMEOUT=
REDIS_SSL_ENABLED=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_STARTTLS_ENABLED=
MAIL_STARTTLS_REQUIRED=
MAIL_SSL_ENABLED=
MAIL_SSL_REQUIRED=

WBE_UPLOAD_DIR=
UPLOAD_MAX_FILE_SIZE=
UPLOAD_MAX_REQUEST_SIZE=
CORS_ALLOWED_ORIGINS=

# 必须精确匹配反向代理源 IP；不要使用匹配所有地址的表达式。
TRUSTED_PROXY_IP_REGEX=

SHUTDOWN_TIMEOUT=
TOMCAT_MAX_THREADS=
TOMCAT_MIN_SPARE_THREADS=
TOMCAT_MAX_CONNECTIONS=
TOMCAT_ACCEPT_COUNT=
TOMCAT_CONNECTION_TIMEOUT=
TOMCAT_KEEP_ALIVE_TIMEOUT=

LOG_FILE=
LOG_MAX_FILE_SIZE=
LOG_MAX_HISTORY=
LOG_TOTAL_SIZE_CAP=
ROOT_LOG_LEVEL=
APP_LOG_LEVEL=
